{
  "name": "spartum",
  "version": "1.0.0",
  "description": "Aplicación de gestión de gimnasio Spartum",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./resources/css/tailwind.css -o ./public/assets/css/tailwind.css --minify",
    "build:images": "node ./scripts/optimize-content-images.mjs",
    "build": "npm run build:css && npm run build:images",
    "watch:css": "tailwindcss -i ./resources/css/tailwind.css -o ./public/assets/css/tailwind.css --watch",
    "test": "npm run build"
  },
